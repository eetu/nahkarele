{
  "name": "nahkarele",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "Interactive nahkarele simulator: be the human relay between two AI agents.",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "validate": "yarn typecheck && yarn lint && yarn format && yarn test"
  },
  "dependencies": {
    "@anarkisti/dab": "portal:../dab/cli",
    "@anarkisti/korpi": "portal:../korpi",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@glowbox/lcd": "^1.12.0",
    "@glowbox/nixie": "^1.12.0",
    "@glowbox/seven-segment": "^1.12.0",
    "@lucide/svelte": "^1.48.0"
  },
  "devDependencies": {
    "@anarkisti/eslint-config": "^1.1.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
